{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SmartMeteringDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "AzureStorage": "UseDevelopmentStorage=true"
  },
  "Jwt": {
    "Key": "ThisIsASecretKeyForJwtTokenGeneration2024!SmartMetering",
    "Issuer": "SmartMetering",
    "Audience": "SmartMeteringApp",
    "ExpirationInMinutes": 60
  },
  "SendGrid": {
    "ApiKey": "your-sendgrid-api-key",
    "FromEmail": "noreply@smartmetering.local",
    "FromName": "SmartMetering",
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Stripe": {
    "SecretKey": "sk_test_your-stripe-secret-key",
    "WebhookSecret": "whsec_your-webhook-secret"
  },
  "BlobStorage": {
    "InvoiceContainer": "invoices",
    "PhotoContainer": "photos"
  },
  "Broadcast": {
    "ApiBaseUrl": "http://localhost:5080/",
    "SharedSecret": "dev-broadcast-secret-key"
  }
}
